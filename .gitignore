# --- WARMVAST: fully self-contained deploy for Endurer Hosting ---
# WordPress core IS committed on purpose (see README "Deployment"): the
# hosting panel does a plain `git pull` into the webroot on every restart
# and expects it to be immediately servable, with no separate install step
# to remember. wp-cli remains the tool for updating core when needed
# (`wp core update` + re-commit), not a build step at deploy time.

# Config & secrets — regenerated by the hosting egg's own wordpress script
# (or by wp-cli locally); must never contain committed real credentials.
/wp-config.php
/.htaccess

# Local dev tooling, not needed on the server.
/wp-cli.phar

# Uploads & generated content
/wp-content/uploads/
/wp-content/upgrade/
/wp-content/cache/

# Default WP plugins/themes we don't use — only our own theme is versioned.
/wp-content/plugins/*
!/wp-content/plugins/index.php
/wp-content/themes/*
!/wp-content/themes/warmvast/

# OS / editor cruft
.DS_Store
Thumbs.db
*.log
